---
import KeystaticEditor from '@keystatic/astro/internal/keystatic-astro-page.astro';

/**
 * Keystatic's editor, pinned to a URL without the deployment base path.
 *
 * The editor is a client-side app with its own router, and that router reads
 * `window.location.pathname` and strips a leading `/keystatic` off it — it
 * knows nothing about Astro's `base`. Opened at /cyh-website/keystatic it
 * parses the base as part of the route, matches nothing, and renders an empty
 * page.
 *
 * The dev server serves this same route with and without the base and reports
 * the base-prefixed path either way, so the two cannot be told apart on the
 * server. Instead rewrite the address bar in place before the editor loads:
 * the document is already here, so this costs no request and cannot bounce.
 *
 * Only ever mounted by `astro dev` (see astro.config.mjs); local mode has
 * nothing to do in a static build.
 */

export const prerender = false;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<script is:inline define:vars={{ base }}>
  if (base && window.location.pathname.startsWith(`${base}/keystatic`)) {
    const { pathname, search, hash } = window.location;
    window.history.replaceState(null, '', pathname.slice(base.length) + search + hash);
  }
</script>

<KeystaticEditor />
