---
import { getEntry, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Blocks from '~/components/Blocks.astro';
import { getSiteSettings } from '~/lib/site';
import { mdxComponents } from '~/components/mdx/components';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.mdx');

const { Content } = await render(page);
const settings = await getSiteSettings();
const { hero, sections, showBody } = page.data;
---

<BaseLayout title={settings.siteName} description={page.data.description}>
  <PageHeader
    title={page.data.title}
    eyebrow={hero?.eyebrow}
    heading={hero?.heading}
    lead={hero?.lead}
    image={hero?.image}
    imageAlt={hero?.imageAlt}
    actions={hero?.actions ?? []}
    theme={hero?.theme ?? 'white'}
  />

  {
    showBody && (
      <section class="section">
        <div class="wrap prose">
          <Content components={mdxComponents} />
        </div>
      </section>
    )
  }

  <Blocks sections={sections} />
</BaseLayout>
