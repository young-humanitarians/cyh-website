---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Blocks from '~/components/Blocks.astro';
import { mdxComponents } from '~/components/mdx/components';

/**
 * Every entry in the `pages` collection except the home page, which has its
 * own route. Drafts are excluded from the build entirely.
 */
export const getStaticPaths = (async () => {
  const pages = await getCollection(
    'pages',
    ({ data }) => data.template !== 'home' && !data.draft,
  );
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
const { hero, seo, sections, showBody } = page.data;
---

<BaseLayout
  title={seo?.title ?? page.data.title}
  description={seo?.description ?? page.data.description}
>
  <PageHeader
    title={page.data.title}
    eyebrow={hero?.eyebrow}
    heading={hero?.heading}
    lead={hero?.lead}
    image={hero?.image}
    imageAlt={hero?.imageAlt}
    actions={hero?.actions ?? []}
    theme={hero?.theme ?? 'white'}
  />

  {
    showBody && (
      <section class="section">
        <div class="wrap prose">
          <Content components={mdxComponents} />
        </div>
      </section>
    )
  }

  <Blocks sections={sections} />
</BaseLayout>
