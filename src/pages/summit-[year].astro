---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import ActionRow from '~/components/ActionRow.astro';
import LogosBlock from '~/components/blocks/LogosBlock.astro';
import { inline } from '~/lib/inline';
import { href as withBase, isExternal } from '~/lib/urls';
import { mdxComponents } from '~/components/mdx/components';

/** One page per Young Humanitarian Summit, at /summit-2026 and so on. */
export const getStaticPaths = (async () => {
  const summits = await getCollection('summits');
  return summits.map((summit) => ({
    params: { year: String(summit.data.year) },
    props: { summit },
  }));
}) satisfies GetStaticPaths;

const { summit } = Astro.props;
const { Content } = await render(summit);
const {
  title,
  description,
  facts,
  tickets,
  stats,
  aftermovieUrl,
  speakers,
  speakersHeading,
  speakersNote,
  workshops,
  workshopsHeading,
  sections,
  outro,
  year,
} = summit.data;
---

<BaseLayout title={title} description={description}>
  <PageHeader title={title} lead={description} />

  <section class="section">
    <div class="wrap prose">
      <Content components={mdxComponents} />
    </div>
  </section>

  {
    facts.length > 0 && (
      <section class="section section--flush" aria-labelledby="facts-heading">
        <div class="wrap">
          <h2 id="facts-heading" class="title-lg">Important info</h2>
          <dl class="facts">
            {facts.map((fact) => (
              <div class="facts__item">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  {
    tickets && (
      <section class="section section--flush" aria-labelledby="tickets-heading">
        <div class="wrap stack" style="--flow: var(--s-4)">
          <h2 id="tickets-heading" class="title-lg">
            {tickets.heading}
          </h2>
          {tickets.text && <p class="lead" set:html={inline(tickets.text)} />}
          {tickets.note && <p set:html={inline(tickets.note)} />}
          {tickets.action && <ActionRow actions={[tickets.action]} />}
        </div>
      </section>
    )
  }

  {
    aftermovieUrl && (
      <section class="section section--flush" aria-labelledby="aftermovie-heading">
        <div class="wrap stack" style="--flow: var(--s-5)">
          <h2 id="aftermovie-heading" class="title-lg">
            Aftermovie
          </h2>
          <div class="aftermovie">
            <iframe
              src={aftermovieUrl}
              title={`Aftermovie — ${title}`}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
              allowfullscreen
            />
          </div>
        </div>
      </section>
    )
  }

  {
    stats.length > 0 && (
      <section class="section section--flush" aria-labelledby="stats-heading">
        <div class="wrap">
          <h2 id="stats-heading" class="title-lg">
            Impact in numbers
          </h2>
          <dl class="stats">
            {stats.map((stat) => (
              <div class="stats__item">
                <dt class="stats__value">{stat.value}</dt>
                <dd class="stats__label">{stat.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  {
    speakers.length > 0 && (
      <section class="section section--flush" aria-labelledby="speakers-heading">
        <div class="wrap stack" style="--flow: var(--s-5)">
          <h2 id="speakers-heading" class="title-lg">
            {speakersHeading}
          </h2>
          <ul class="speakers">
            {speakers.map((speaker) => (
              <li class="speaker">
                <h3 class="speaker__name title-sm">{speaker.name}</h3>
                {speaker.role && <p class="speaker__role">{speaker.role}</p>}
              </li>
            ))}
          </ul>
          {speakersNote && <p class="lead">{speakersNote}</p>}
        </div>
      </section>
    )
  }

  {
    workshops.length > 0 && (
      <section class="section" data-theme="black" aria-labelledby="workshops-heading">
        <div class="wrap stack" style="--flow: var(--s-5)">
          <h2 id="workshops-heading" class="title-lg">
            {workshopsHeading}
          </h2>
          <ul class="workshops">
            {workshops.map((workshop) => (
              <li class="workshop">
                <h3 class="title-sm">{workshop.title}</h3>
                {workshop.organisation && <p class="workshop__org">{workshop.organisation}</p>}
                {workshop.format && <p class="workshop__format">{workshop.format}</p>}
                {workshop.description && <p>{workshop.description}</p>}
                {workshop.link && (
                  <p>
                    <a
                      href={withBase(workshop.link.href)}
                      {...(isExternal(workshop.link.href)
                        ? { target: '_blank', rel: 'noopener' }
                        : {})}
                    >
                      {workshop.link.label}
                      <span aria-hidden="true"> →</span>
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    sections.map((item) => (
      <section class="section section--flush">
        <div class="wrap stack" style="--flow: var(--s-4)">
          <h2 class="title-lg">{item.heading}</h2>
          {item.text && <p class="lead" set:html={inline(item.text)} />}
          {item.items.length > 0 && (
            <ul class="plain-list">
              {item.items.map((entry) => (
                <li set:html={inline(entry)} />
              ))}
            </ul>
          )}
        </div>
      </section>
    ))
  }

  <LogosBlock
    block={{
      type: 'logos',
      theme: 'white',
      heading: 'Thank you to our Summit Partners & Supporters',
      category: 'summit',
      actions: [],
      anchor: `summit-${year}-partners`,
    }}
  />

  {
    outro && (
      <section class="section" data-theme="black" aria-labelledby="outro-heading">
        <div class="wrap stack" style="--flow: var(--s-5)">
          <h2 id="outro-heading" class="title-lg">
            Terms &amp; conditions and data protection
          </h2>
          {outro.text && <p class="lead" set:html={inline(outro.text)} />}
          <ActionRow actions={outro.actions} />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .facts,
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--s-5);
    margin: var(--s-6) 0 0;
  }

  .facts__item,
  .stats__item {
    padding-block-start: var(--s-4);
    border-block-start: 2px solid var(--c-accent);
  }

  .facts__item dt {
    font-size: var(--t-sm);
  }

  .facts__item dd {
    margin: var(--s-1) 0 0;
    font-family: var(--f-heading);
    font-size: var(--t-h4);
  }

  .stats__value {
    font-family: var(--f-heading);
    font-size: var(--t-h2);
    font-weight: 500;
    line-height: 1.1;
  }

  .stats__label {
    margin: var(--s-2) 0 0;
    font-size: var(--t-sm);
  }

  .aftermovie {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 60rem;
  }

  .aftermovie iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .speakers,
  .workshops {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .speaker {
    padding-block-start: var(--s-3);
    border-block-start: 1px solid var(--c-rule);
  }

  .speaker__name {
    margin: 0;
  }

  .speaker__role {
    font-size: var(--t-sm);
  }

  .workshops {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .workshop {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
  }

  .workshop__org,
  .workshop__format {
    font-size: var(--t-sm);
    color: var(--c-accent);
  }

  .workshop a {
    color: var(--c-link);
  }

  .plain-list {
    padding-inline-start: 1.35em;
  }

  .plain-list li + li {
    margin-block-start: var(--s-2);
  }
</style>
