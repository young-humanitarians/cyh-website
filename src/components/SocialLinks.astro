---
import type { SiteSettings } from '~/lib/site';

interface Props {
  items: SiteSettings['social'];
  label: string;
}

const { items, label } = Astro.props;

/** Simple monochrome glyphs so no icon package is needed. */
const paths: Record<Props['items'][number]['platform'], string> = {
