---
import { Image } from 'astro:assets';
import logo from '~/assets/brand/cyh-logo.png';
import { href, isCurrent } from '~/lib/urls';
import type { SiteSettings } from '~/lib/site';

interface Props {
  settings: SiteSettings;
  path: string;
}

const { settings, path } = Astro.props;
const { navigation, ui, siteName, logoAlt } = settings;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href={href('/')}>
      <Image src={logo} alt={logoAlt} width={112} height={112} loading="eager" />
      <span class="visually-hidden">{siteName}</span>
    </a>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
      data-label-open={ui.openMenu}
      data-label-close={ui.closeMenu}
    >
      <span class="site-header__toggle-bars" aria-hidden="true"></span>
      <span data-nav-toggle-label>{ui.openMenu}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={ui.mainNavigation} data-nav>
      <ul class="site-nav__list">
        {
          navigation.map((item) => {
            const hasChildren = item.children.length > 0;
            const active =
              (item.href && isCurrent(path, item.href)) ||
              item.children.some((child) => isCurrent(path, child.href));

            return (
              <li class:list={['site-nav__item', hasChildren && 'site-nav__item--group']}>
                {item.href ? (
                  <a
                    class="site-nav__link"
                    href={href(item.href)}
                    aria-current={active && !hasChildren ? 'page' : undefined}
                    data-active={active ? '' : undefined}
                  >
                    {item.label}
                  </a>
                ) : (
                  <span class="site-nav__link" data-active={active ? '' : undefined}>
                    {item.label}
                  </span>
                )}

                {hasChildren && (
                  <ul class="site-nav__sub">
                    {item.children.map((child) => (
                      <li>
                        <a
                          class="site-nav__sublink"
                          href={href(child.href)}
                          aria-current={isCurrent(path, child.href) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--c-rule);
    background: var(--c-paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    flex-wrap: wrap;
    padding-block: var(--s-3);
  }

  .site-header__brand {
    display: block;
    flex: none;
  }

  .site-header__brand :global(img) {
    width: 4rem;
    height: auto;
    transition: transform 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header__brand:hover :global(img),
  .site-header__brand:focus-visible :global(img) {
    transform: rotate(360deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__brand :global(img) {
      transition: none;
    }

    .site-header__brand:hover :global(img),
    .site-header__brand:focus-visible :global(img) {
      transform: none;
    }
  }

  @media (min-width: 60rem) {
    .site-header__brand :global(img) {
      width: 5.25rem;
    }
  }

  /* -- toggle (small screens only) -- */

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    font-family: var(--f-heading);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--c-ink);
    background: transparent;
    border: 1.5px solid var(--c-rule);
    border-radius: 999px;
    cursor: pointer;
  }

  .site-header__toggle-bars,
  .site-header__toggle-bars::before,
  .site-header__toggle-bars::after {
    display: block;
    width: 1rem;
    height: 2px;
    background: currentColor;
    content: '';
  }

  .site-header__toggle-bars {
    position: relative;
  }

  .site-header__toggle-bars::before {
    position: absolute;
    inset-block-start: -5px;
  }

  .site-header__toggle-bars::after {
    position: absolute;
    inset-block-start: 5px;
  }

  /* -- navigation -- */

  .site-nav {
    flex-basis: 100%;
  }

  .site-nav__list,
  .site-nav__sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link,
  .site-nav__sublink {
    display: block;
    font-family: var(--f-heading);
    font-weight: 600;
    text-decoration: none;
    color: var(--c-ink);
  }

  .site-nav__link {
    font-size: var(--t-sm);
    letter-spacing: 0.02em;
    padding-block: var(--s-2);
  }

  .site-nav__sublink {
    font-weight: 500;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    padding-block: var(--s-1);
  }

  .site-nav__link[data-active],
  .site-nav__sublink[aria-current='page'] {
    color: var(--c-red);
  }

  a.site-nav__link:hover,
  .site-nav__sublink:hover {
    color: var(--c-red-dark);
  }

  /* Small screens: the whole menu collapses behind the toggle. */
  @media (max-width: 61.99rem) {
    .site-nav {
      display: none;
      padding-block: var(--s-3) var(--s-5);
      border-block-start: 1px solid var(--c-rule);
    }

    .site-nav[data-open] {
      display: block;
    }

    .site-nav__item + .site-nav__item {
      border-block-start: 1px solid var(--c-rule);
    }

    .site-nav__sub {
      padding-block-end: var(--s-2);
      padding-inline-start: var(--s-3);
      border-inline-start: 2px solid var(--c-rule);
    }
  }

  /* Wide screens: a single row, with sub-menus revealed on hover or focus. */
  @media (min-width: 62rem) {
    .site-header__toggle {
      display: none;
    }

    .site-nav {
      flex-basis: auto;
    }

    .site-nav__list {
      display: flex;
      align-items: center;
      gap: clamp(var(--s-4), 2vw, var(--s-6));
    }

    .site-nav__item--group {
      position: relative;
    }

    .site-nav__sub {
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: calc(var(--s-4) * -1);
      z-index: 20;
      min-width: 14rem;
      padding: var(--s-3);
      background: var(--c-paper);
      border: 1px solid var(--c-rule);
      border-radius: var(--radius);
      box-shadow: 0 12px 28px hsl(0 0% 0% / 0.55);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 120ms ease,
        visibility 120ms ease;
    }

    .site-nav__item--group:hover > .site-nav__sub,
    .site-nav__item--group:focus-within > .site-nav__sub {
      visibility: visible;
      opacity: 1;
    }

    .site-nav__sublink {
      padding: var(--s-2) var(--s-3);
      border-radius: var(--radius);
    }

    .site-nav__sublink:hover {
      background: var(--c-paper-warm);
    }
  }
</style>

<script>
  // The only interactive element on the site: the small-screen menu toggle.
  // Sub-menus open on hover and on keyboard focus via CSS, so they work
  // without JavaScript.
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const label = document.querySelector<HTMLElement>('[data-nav-toggle-label]');

  toggle?.addEventListener('click', () => {
    const open = nav?.hasAttribute('data-open') ?? false;
    if (open) {
      nav?.removeAttribute('data-open');
    } else {
      nav?.setAttribute('data-open', '');
    }
    toggle.setAttribute('aria-expanded', String(!open));
    if (label) {
      label.textContent = !open
        ? (toggle.dataset.labelClose ?? '')
        : (toggle.dataset.labelOpen ?? '');
    }
  });
</script>
