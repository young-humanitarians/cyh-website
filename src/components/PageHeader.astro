---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ActionRow from '~/components/ActionRow.astro';
import { inline } from '~/lib/inline';
import type { Action } from '~/lib/blocks';

interface Props {
  title: string;
  eyebrow?: string | undefined;
  heading?: string | undefined;
  lead?: string | undefined;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  actions?: readonly Action[] | readonly { label: string; href: string }[];
  theme?: 'white' | 'black' | 'bright';
}

const {
  title,
  eyebrow,
  heading,
  lead,
  image,
  imageAlt,
  actions = [],
  theme = 'white',
} = Astro.props;
---

<div
  class:list={['page-header', image && 'page-header--split']}
  data-theme={theme === 'white' ? undefined : theme}
>
  <div class="wrap page-header__inner">
    <div class="stack" style="--flow: var(--s-5)">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="title-xl">{heading ?? title}</h1>
      {lead && <p class="lead" set:html={inline(lead)} />}
      <ActionRow actions={actions} />
    </div>

    {
      image && (
        <figure class="page-header__figure">
          <Image
            src={image}
            alt={imageAlt ?? ''}
            widths={[480, 960]}
            sizes="(min-width: 60rem) 32rem, 90vw"
            loading="eager"
          />
        </figure>
      )
    }
  </div>
</div>

<style>
  .page-header {
    padding-block: var(--s-8);
    background: var(--c-bg);
    color: var(--c-fg);
  }

  .page-header__inner {
    display: grid;
    gap: var(--s-7);
  }

  @media (min-width: 60rem) {
    .page-header--split .page-header__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
      align-items: center;
    }
  }

  .page-header__figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .page-header__figure :global(img) {
    width: 100%;
    height: 100%;
    max-height: 28rem;
    object-fit: cover;
  }

  .page-header .lead {
    max-width: var(--measure);
  }

  .page-header :global(a) {
    color: var(--c-link);
  }

  .page-header :global(.button) {
    color: var(--c-btn-fg);
  }

  .page-header :global(.button--secondary),
  .page-header :global(.button--tertiary) {
    color: var(--c-fg);
  }
</style>
