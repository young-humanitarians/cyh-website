---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ActionRow from '~/components/ActionRow.astro';
import HeroTicker from '~/components/HeroTicker.astro';
import { inline } from '~/lib/inline';
import type { Action } from '~/lib/blocks';

/**
 * Every page opens the same way: a full-bleed photo band where there is a
 * hero image, then the title running the full page width beneath it
 * (design-rules §9, "The home page carries a full-bleed hero image" — the
 * 2026 revamp applies that shape to every page).
 */
type Focus =
  | 'top'
  | 'upper'
  | 'upper-middle'
  | 'middle'
  | 'lower-middle'
  | 'lower'
  | 'bottom';

interface Props {
  title: string;
  eyebrow?: string | undefined;
  heading?: string | undefined;
  lead?: string | undefined;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  /** Which part of the photo the banner is centred on. */
  focus?: Focus;
  actions?: readonly Action[] | readonly { label: string; href: string }[];
  /** Scrolling call-to-action strip; see HeroTicker.astro. */
  ticker?: { text?: string | undefined; href?: string | undefined } | undefined;
  theme?: 'white' | 'black' | 'bright';
}

const {
  title,
  eyebrow,
  heading,
  lead,
  image,
  imageAlt,
  focus = 'middle',
  actions = [],
  ticker,
  theme = 'white',
} = Astro.props;

/**
 * Where in the photo, top to bottom, the band should be centred. Positions in
 * the frame rather than an even ramp: the steps are placed where the hero
 * photographs actually put their subject — a sign held overhead sits near 30%,
 * one held at chest height near 50%, one held low near 62%.
 */
const FOCUS_POSITION: Record<Focus, number> = {
  top: 10,
  upper: 30,
  'upper-middle': 40,
  middle: 50,
  'lower-middle': 62,
  lower: 75,
  bottom: 90,
};

/*
 * The band is a slim window on an image scaled to fill it, so the point that
 * lands at the band's centre is not the `object-position` percentage. With
 * `cover`, the visible centre sits at `r/2 + p(1 - r)` of the image, where r
 * is the share of the image on show. Solving for p gives the position that
 * puts the chosen focal point in the middle of the band.
 *
 * r depends on the image's own aspect ratio and on the band's size, which
 * changes with the window — hence one value per breakpoint, computed from the
 * real image rather than hardcoded, so portrait and landscape both work.
 */
const BANDS = [
  { name: 'sm', width: 390, height: 253 },
  { name: 'md', width: 880, height: 307 },
  { name: 'lg', width: 1440, height: 270 },
] as const;

function objectPosition(
  target: number,
  band: { width: number; height: number },
  ratio: number,
): string {
  const share = Math.min(0.95, band.height / (band.width * ratio));
  const position = (target / 100 - share / 2) / (1 - share);
  return `${(Math.min(1, Math.max(0, position)) * 100).toFixed(1)}%`;
}

const bandPositions = image
  ? BANDS.map(
      (band) =>
        `--hero-${band.name}: ${objectPosition(FOCUS_POSITION[focus], band, image.height / image.width)}`,
    ).join('; ')
  : undefined;

const tickerText = ticker?.text;
---

<div
  class:list={['page-header', image && 'page-header--banner']}
  data-theme={theme === 'white' ? undefined : theme}
>
  {
    image && (
      <figure class="page-header__banner" style={bandPositions}>
        <Image
          src={image}
          alt={imageAlt ?? ''}
          widths={[640, 1000]}
          sizes="100vw"
          loading="eager"
        />
        {tickerText && <HeroTicker text={tickerText} href={ticker?.href} overlay />}
      </figure>
    )
  }

  <div class="wrap stack" style="--flow: var(--s-5)">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="title-xl">{heading ?? title}</h1>
    {lead && <p class="lead" set:html={inline(lead)} />}
    <ActionRow actions={actions} />
  </div>

  {!image && tickerText && <HeroTicker text={tickerText} href={ticker?.href} />}
</div>

<style>
  .page-header {
    padding-block: var(--s-8);
    background: var(--c-bg);
    color: var(--c-fg);
  }

  /* With a banner, the photo is the first thing on the page. */
  .page-header--banner {
    padding-block-start: 0;
  }

  /*
   * Without a hero image the strip has no photo to sit on, so it becomes the
   * bottom edge of the header — the negative margin cancels the header's own
   * bottom padding so the band runs flush into whatever follows.
   */
  .page-header > :global(.ticker) {
    margin-block: var(--s-8) calc(var(--s-8) * -1);
  }

  /*
   * A direct child of .page-header, which carries no inline padding, so it
   * reaches both window edges. Square corners: design-rules §9 forbids
   * rounding photos, and a full-bleed image has no edge to round anyway.
   */
  .page-header__banner {
    position: relative;
    margin: 0 0 var(--s-8);
    /* A height of its own, so the image can be taller than it and be clipped
       when it drifts on scroll (see "scroll motion" in global.css). */
    height: clamp(14rem, 30vh, 22rem);
    overflow: hidden;
  }

  /*
   * One position per breakpoint, worked out per image in the frontmatter
   * above. Without this the focal point drifts: the band's height barely
   * changes with the window while its width changes a lot, so the share of
   * the photo on show swings from roughly 43% on a phone to 9% on a wide
   * monitor for a portrait photo. It is what keeps the home page's ticker off
   * the two lines of the cardboard sign at every size.
   */
  .page-header__banner :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--hero-sm);
  }

  @media (min-width: 48rem) {
    .page-header__banner :global(img) {
      object-position: center var(--hero-md);
    }
  }

  @media (min-width: 62rem) {
    .page-header__banner :global(img) {
      object-position: center var(--hero-lg);
    }
  }

  /*
   * Deliberately not centred, unlike the reading columns further down the
   * page: the h1 above it runs the full page width and is flush left, so a
   * centred lead would start somewhere in the middle of its own title.
   */
  .page-header .lead {
    max-width: var(--measure);
  }

  /*
   * Both exclusions are there because this selector outranks the rules those
   * elements set for themselves, and both would otherwise end up dark red on
   * a red background. The ticker paints its own white-on-red. Buttons take
   * their colour from --c-btn-fg, and `:not()` carries the specificity of its
   * argument, so a bare `:not(.ticker)` here scored higher than the .button
   * rule below and won.
   */
  .page-header :global(a:not(.ticker, .button)) {
    color: var(--c-link);
  }

</style>
