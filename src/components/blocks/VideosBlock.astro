---
import Section from '~/components/Section.astro';
import Placeholder from '~/components/Placeholder.astro';
import { inline } from '~/lib/inline';
import type { Block } from '~/lib/blocks';

/**
 * Embedded video. `loading="lazy"` keeps the player off the critical path and
 * the title attribute is required — an unlabelled iframe is unusable with a
 * screen reader.
 */
interface Props {
  block: Block<'videos'>;
}

const { block } = Astro.props;
const { items, placeholder, ...section } = block;
---

<Section {...section}>
  {items.length === 0 && placeholder && <Placeholder text={placeholder} />}
  <ul class="videos">
    {
      items.map((item) => (
        <li class="videos__item">
          <div class="videos__frame">
            <iframe
              src={item.embedUrl}
              title={item.title}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
              allowfullscreen
            />
          </div>
          <h3 class="videos__title title-sm">{item.title}</h3>
          {item.text && <p set:html={inline(item.text)} />}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .videos__item > * + * {
    margin-block-start: var(--s-3);
  }

  .videos__frame {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .videos__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .videos__title {
    margin: 0;
  }
</style>
