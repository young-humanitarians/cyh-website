---
import Section from '~/components/Section.astro';
import Placeholder from '~/components/Placeholder.astro';
import { inline } from '~/lib/inline';
import { href as withBase, isExternal } from '~/lib/urls';
import type { Block } from '~/lib/blocks';

/**
 * Sourced claims. The draft asks for the source to be a link rather than a
 * parenthetical, so the citation is the interactive element and the claim
 * stays readable.
 */
interface Props {
  block: Block<'evidence'>;
}

const { block } = Astro.props;
const { items, placeholder, ...section } = block;
---

<Section {...section}>
  {items.length === 0 && placeholder && <Placeholder text={placeholder} />}
  <ul class="evidence">
    {
      items.map((item) => (
        <li class="evidence__item">
          <p class="evidence__claim" set:html={inline(item.text)} />
          {item.href ? (
            <a
              class="evidence__source"
              href={withBase(item.href)}
              {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {item.source}
            </a>
          ) : (
            <p class="evidence__source evidence__source--plain">{item.source}</p>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .evidence {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .evidence__item {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
  }

  .evidence__claim {
    font-size: var(--t-lg);
    margin: 0;
  }

  .evidence__source {
    margin: auto 0 0;
    font-size: var(--t-sm);
    font-weight: 400;
    color: var(--c-link);
  }

  .evidence__source--plain {
    color: inherit;
  }
</style>
