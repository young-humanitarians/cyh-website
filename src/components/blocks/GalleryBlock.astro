---
import { Image } from 'astro:assets';
import Section from '~/components/Section.astro';
import Placeholder from '~/components/Placeholder.astro';
import type { Block } from '~/lib/blocks';

interface Props {
  block: Block<'gallery'>;
}

const { block } = Astro.props;
const { items, placeholder, ...section } = block;
---

<Section {...section}>
  {items.length === 0 && placeholder && <Placeholder text={placeholder} />}
  <ul class="gallery">
    {
      items.map((item) => (
        <li>
          <figure class="gallery__figure">
            <Image
              src={item.image}
              alt={item.alt}
              widths={[480, 840, 1200]}
              sizes="(min-width: 75rem) 30vw, (min-width: 48rem) 45vw, 90vw"
              loading="lazy"
            />
            {item.caption && <figcaption class="gallery__caption">{item.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gallery__figure {
    margin: 0;
  }

  /* Photography stays uncropped and unfiltered — docs/design-rules.md §9. */
  .gallery__figure :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .gallery__caption {
    margin-block-start: var(--s-2);
    font-size: var(--t-sm);
  }
</style>
